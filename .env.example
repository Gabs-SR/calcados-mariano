# Copie este arquivo para .env e ajuste os valores.
# O arquivo .env não é versionado.

# Porta HTTP do backend.
PORT=3000

# Conexão PostgreSQL do Supabase.
# Use a URL de conexão fornecida pelo Supabase.
DATABASE_URL=

# Ajustes opcionais do pool PostgreSQL.
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000

# Origens permitidas pela API, separadas por vírgula.
# Em desenvolvimento pode ficar vazio.
# Em produção, informe a URL da interface, por exemplo:
# CORS_ORIGINS=https://sua-vitrine.vercel.app
CORS_ORIGINS=

# ---- Autenticação do painel ----
# Sem estas duas variáveis, as rotas de escrita respondem 503 e o login recusa tudo.
# NÃO existe senha padrão.
#
# Gere as duas linhas com:
#   npm run auth:hash -- "a sua senha"

ADMIN_SENHA_HASH=
SESSAO_SEGREDO=
